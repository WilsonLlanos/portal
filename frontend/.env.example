# Copie para .env.local e preencha. NUNCA versione o .env.local.

# URL pública do site, usada para metadados de SEO/Open Graph (metadataBase)
# e para o link de verificação de idiomas. Em produção, a Vercel expõe isso
# automaticamente; localmente aponta para o dev server.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origem do backend (FastAPI) para o rewrite de /api/* — ver next.config.ts.
# Em produção, configurar com a URL do projeto Vercel do backend.
BACKEND_ORIGIN=http://127.0.0.1:8000
