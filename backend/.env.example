# Copie para .env e preencha com valores reais. NUNCA versione o .env
# (ver constituição, Princípio IX — Gestão de Credenciais).

# --- LLM (Gemini, camada paga — decisão O1 do plan.md) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Guardrail (Prompt Guard 2 via Groq, camada gratuita — decisão O2) ---
GROQ_API_KEY=
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
GUARD_TIMEOUT_SECONDS=2
GUARD_BLOCK_THRESHOLD=0.5

# --- Estado compartilhado (rate limit e teto diário) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observabilidade ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Limites do chat (decisão O3 do plan.md) ---
MAX_MESSAGE_LENGTH=500
DAILY_COST_CAP_CENTS=50
RATE_LIMIT_PER_HOUR=20

# --- Diversos ---
# Origens do frontend autorizadas a chamar o backend diretamente (dev local).
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
